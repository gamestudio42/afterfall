{
  "name": "@afterfall/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "AFTERFALL desktop shell (Electron), packaged as a snap",
  "author": "Marcel Savegnago",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/gamestudio42/afterfall",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "pnpm --filter @afterfall/web build && tsc -p tsconfig.json && node scripts/copy-game.mjs",
    "start": "pnpm build && electron .",
    "smoke": "pnpm build && electron . --no-sandbox --smoke",
    "dist:dir": "pnpm build && electron-builder --linux dir --publish never"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "typescript": "5.7.2"
  },
  "build": {
    "appId": "io.github.gamestudio42.Afterfall",
    "productName": "AFTERFALL",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "game/**",
      "preload.cjs",
      "package.json"
    ],
    "asar": true,
    "linux": {
      "category": "Game",
      "icon": "build/icon.png",
      "synopsis": "Scavenge by day, hold the night and rebuild the city",
      "executableName": "afterfall"
    },
    "publish": []
  }
}
