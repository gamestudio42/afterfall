[
  { "command": "comp.new", "params": { "name": "muzzle_flash", "width": 256, "height": 256, "frameRate": 30, "duration": 0.2 } },
  { "command": "layer.newShape", "params": { "kind": "star", "name": "flare", "size": [220, 220], "fill": "#ff9a3c" } },
  { "command": "prop.set", "params": { "layer": "flare", "path": "contents/group/contents/star/points", "value": 7 } },
  { "command": "prop.set", "params": { "layer": "flare", "path": "contents/group/contents/star/innerRadius", "value": 16 } },
  { "command": "prop.set", "params": { "layer": "flare", "path": "contents/group/contents/star/outerRadius", "value": 112 } },
  { "command": "layer.newShape", "params": { "kind": "star", "name": "spikes", "size": [160, 160], "fill": "#ffd866" } },
  { "command": "prop.set", "params": { "layer": "spikes", "path": "contents/group/contents/star/points", "value": 5 } },
  { "command": "prop.set", "params": { "layer": "spikes", "path": "contents/group/contents/star/innerRadius", "value": 12 } },
  { "command": "prop.set", "params": { "layer": "spikes", "path": "contents/group/contents/star/outerRadius", "value": 76 } },
  { "command": "prop.set", "params": { "layer": "spikes", "path": "contents/group/contents/star/rotation", "value": 20 } },
  { "command": "layer.newShape", "params": { "kind": "ellipse", "name": "core", "size": [62, 62], "fill": "#fff8e8" } },
  { "command": "effect.apply", "params": { "effect": "Glow", "layers": ["core"] } },
  { "command": "effect.apply", "params": { "effect": "Glow", "layers": ["spikes"] } },
  { "command": "effect.apply", "params": { "effect": "Glow", "layers": ["flare"] } },

  { "command": "prop.addKey", "params": { "layer": "core", "path": "transform/scale", "time": 0.0, "value": [80, 80, 100] } },
  { "command": "prop.addKey", "params": { "layer": "core", "path": "transform/scale", "time": 0.033, "value": [125, 125, 100] } },
  { "command": "prop.addKey", "params": { "layer": "core", "path": "transform/scale", "time": 0.15, "value": [45, 45, 100] } },
  { "command": "prop.addKey", "params": { "layer": "core", "path": "transform/opacity", "time": 0.0, "value": 100 } },
  { "command": "prop.addKey", "params": { "layer": "core", "path": "transform/opacity", "time": 0.067, "value": 100 } },
  { "command": "prop.addKey", "params": { "layer": "core", "path": "transform/opacity", "time": 0.15, "value": 0 } },

  { "command": "prop.addKey", "params": { "layer": "flare", "path": "transform/scale", "time": 0.0, "value": [85, 85, 100] } },
  { "command": "prop.addKey", "params": { "layer": "flare", "path": "transform/scale", "time": 0.033, "value": [112, 112, 100] } },
  { "command": "prop.addKey", "params": { "layer": "flare", "path": "transform/scale", "time": 0.133, "value": [60, 60, 100] } },
  { "command": "prop.addKey", "params": { "layer": "flare", "path": "transform/opacity", "time": 0.0, "value": 100 } },
  { "command": "prop.addKey", "params": { "layer": "flare", "path": "transform/opacity", "time": 0.033, "value": 95 } },
  { "command": "prop.addKey", "params": { "layer": "flare", "path": "transform/opacity", "time": 0.133, "value": 0 } },
  { "command": "prop.addKey", "params": { "layer": "flare", "path": "transform/rotation", "time": 0.0, "value": 0 } },
  { "command": "prop.addKey", "params": { "layer": "flare", "path": "transform/rotation", "time": 0.133, "value": 14 } },

  { "command": "prop.addKey", "params": { "layer": "spikes", "path": "transform/scale", "time": 0.0, "value": [90, 90, 100] } },
  { "command": "prop.addKey", "params": { "layer": "spikes", "path": "transform/scale", "time": 0.067, "value": [120, 120, 100] } },
  { "command": "prop.addKey", "params": { "layer": "spikes", "path": "transform/scale", "time": 0.133, "value": [70, 70, 100] } },
  { "command": "prop.addKey", "params": { "layer": "spikes", "path": "transform/opacity", "time": 0.0, "value": 100 } },
  { "command": "prop.addKey", "params": { "layer": "spikes", "path": "transform/opacity", "time": 0.1, "value": 60 } },
  { "command": "prop.addKey", "params": { "layer": "spikes", "path": "transform/opacity", "time": 0.133, "value": 0 } },
  { "command": "prop.addKey", "params": { "layer": "spikes", "path": "transform/rotation", "time": 0.0, "value": 0 } },
  { "command": "prop.addKey", "params": { "layer": "spikes", "path": "transform/rotation", "time": 0.133, "value": -10 } },

  { "command": "file.save", "params": { "path": "muzzle_flash.ecproj" } }
